APP_NAME=MADP Assistant Learning
APP_ENV=development

JAVA_BACKEND_URL=http://127.0.0.1:8080/api/v1
JAVA_BACKEND_TIMEOUT_SECONDS=10

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CHECKPOINT_TTL_MINUTES=10080
CHAT_LOCK_TTL_SECONDS=180

# RAG 知识库使用的 Milvus 服务。
MILVUS_URI=http://127.0.0.1:19530
# 本地未开启鉴权时保持为空；开启鉴权后再填写。
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=medical_knowledge
# 必须与 Embedding 模型实际输出维度一致。
EMBEDDING_DIMENSION=1024
# RAG 检索最低余弦相似度，可根据真实问题集评估后调整。
KNOWLEDGE_MIN_RELEVANCE_SCORE=0.45

LLM_MODEL=qwen3.7-flash
LLM_MODEL2=qwen3.8-27b
# RAG 文档和查询使用的文本向量模型。
LLM_MODEL3=qwen3.7-text-embedding-flash
LLM_BASE_URL=https://your-qwen-compatible-endpoint/v1
LLM_API_KEY=replace-with-your-api-key
LLM_TIMEOUT_SECONDS=30

CONTEXT_EDITING_TRIGGER_TOKENS=5000
CONTEXT_EDITING_KEEP_TOOL_USES=3
CONTEXT_EDITING_CLEAR_AT_LEAST_TOKENS=1000
SUMMARIZATION_TRIGGER_TOKENS=8000
SUMMARIZATION_KEEP_MESSAGES=12
