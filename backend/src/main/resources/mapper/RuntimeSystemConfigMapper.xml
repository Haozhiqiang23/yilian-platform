<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yilian.madp.systemconfig.mapper.RuntimeSystemConfigMapper">

    <select id="selectRefundEnabled" resultType="java.lang.Boolean">
        SELECT refund_enabled
        FROM system_config
        WHERE id = 1
    </select>

    <select id="selectAppointmentCancelHours" resultType="java.lang.Integer">
        SELECT appointment_cancel_hours
        FROM system_config
        WHERE id = 1
    </select>

    <select id="selectSignInAheadMinutes" resultType="java.lang.Integer">
        SELECT sign_in_ahead_minutes
        FROM system_config
        WHERE id = 1
    </select>

    <select id="selectQueuePollSeconds" resultType="java.lang.Integer">
        SELECT queue_poll_seconds
        FROM system_config
        WHERE id = 1
    </select>

</mapper>
